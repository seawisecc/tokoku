# ============================================================
# TokoKu — variabel lingkungan
# Salin file ini jadi .env.local lalu isi nilainya.
#   cp .env.local.example .env.local
# .env.local TIDAK ikut ter-commit (sudah ada di .gitignore).
# ============================================================

# --- Supabase ---
# Ambil dari dashboard Supabase → Project Settings → Data API / API Keys
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Kunci service_role. HANYA dipakai di server (route handler / server action).
# Melewati seluruh RLS — jangan pernah diawali NEXT_PUBLIC_ dan jangan
# pernah diimpor ke komponen client.
SUPABASE_SERVICE_ROLE_KEY=

# --- Aplikasi ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=TokoKu
NEXT_PUBLIC_BRAND_TAGLINE="by Seawise Studio"

# --- Email transaksional (OPSIONAL) ---
# Tanpa ini aplikasi tetap jalan penuh: undangan tim dibuat seperti biasa dan
# tautannya ditampilkan untuk dikirim manual lewat WhatsApp. Diisi, undangannya
# ikut dikirim lewat email.
#
# Kunci API dari https://resend.com (kuota gratis 3.000 email/bulan).
# EMAIL_FROM harus memakai domain yang sudah diverifikasi di sana — tanpa itu
# penyedia menolak dengan 422 dan aplikasinya akan bilang begitu apa adanya.
#
# Penyedia yang sama sebaiknya dipasang juga sebagai Custom SMTP di Supabase
# (Authentication → Emails). Email bawaan Supabase untuk konfirmasi pendaftaran
# dan reset sandi dibatasi beberapa email per jam — tidak untuk produksi.
RESEND_API_KEY=
EMAIL_FROM=TokoKu <undangan@domain-anda.id>

# --- Pemantauan error (OPSIONAL) ---
# Tanpa DSN, Sentry tidak pernah di-init dan `next.config.ts` tidak
# membungkusnya sama sekali — build maupun runtime persis seperti tanpa Sentry.
# Ambil DSN dari sentry.io → Project Settings → Client Keys (DSN).
NEXT_PUBLIC_SENTRY_DSN=
# Tiga di bawah ini HANYA untuk mengunggah source map saat build, supaya nomor
# baris di laporan error menunjuk kode asli. Tanpa ini errornya tetap terkirim.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
